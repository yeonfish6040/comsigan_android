<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/preview_background"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3-4"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="@color/preview_text" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="목요일"
            android:textSize="11sp"
            android:textColor="@color/preview_muted" />
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="한국디지털미디어고등학"
            android:textSize="10sp"
            android:textColor="@color/preview_muted" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="9dp"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:layout_marginVertical="2dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/preview_cell">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:textSize="9sp"
                android:textColor="@color/preview_muted" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="커문"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="@color/preview_text" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="기하"
                android:textSize="9sp"
                android:textColor="@color/preview_muted" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:layout_marginVertical="2dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/preview_cell">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2"
                android:textSize="9sp"
                android:textColor="@color/preview_muted" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DB"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="@color/preview_text" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="혁준"
                android:textSize="9sp"
                android:textColor="@color/preview_muted" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:layout_marginVertical="2dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/preview_cell">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3"
                android:textSize="9sp"
                android:textColor="@color/preview_muted" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="빅데"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="@color/preview_text" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="재훈"
                android:textSize="9sp"
                android:textColor="@color/preview_muted" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:layout_marginVertical="2dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/preview_cell">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4"
                android:textSize="9sp"
                android:textColor="@color/preview_muted" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="응개"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="@color/preview_text" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="성수"
                android:textSize="9sp"
                android:textColor="@color/preview_muted" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:layout_marginVertical="2dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/preview_cell">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5"
                android:textSize="9sp"
                android:textColor="@color/preview_muted" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="비영"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="@color/preview_text" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="재덕"
                android:textSize="9sp"
                android:textColor="@color/preview_muted" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:layout_marginVertical="2dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/preview_accent_cell">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6"
                android:textSize="9sp"
                android:textColor="@color/preview_muted" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="공수"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="@color/preview_text" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="재영"
                android:textSize="9sp"
                android:textColor="@color/preview_muted" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
